[Unit]
Description=PSC SOC Rsyslog SIEM MVP
After=network.target rsyslog.service
Requires=rsyslog.service


[Service]

Type=simple

User=socsiem
Group=socsiem

WorkingDirectory=/opt/soc/backend

Environment=SOC_LOCAL_IP=172.16.16.141
Environment=SOC_LOG_FILE=/var/log/soc-rsyslog.log
Environment=SOC_DB=/opt/soc/backend/siem.db

Environment=SOC_BOOTSTRAP_LINES=500
Environment=SOC_WINDOW_MINUTES=30
Environment=SOC_MIN_CORRELATION_SCORE=60

ExecStart=/opt/soc/venv/bin/gunicorn \
    --workers 1 \
    --bind 127.0.0.1:8000 \
    --timeout 60 \
    app:app

Restart=always
RestartSec=3


[Install]
WantedBy=multi-user.target
